html_content = """<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>칭찬(과 독설의) 키보드</title>
    <style>
        * {
            box-sizing: border-box;
