        /* Animations */
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-12px); }
            40%, 80% { transform: translateX(12px); }
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>✨ 칭찬만(?) 하는 키보드 ✨</h1>
        <p class="subtitle">아무 키나 눌러보세요! 당신을 향한 칭찬이 쏟아집니다 (아마도...?)</p>

        <div class="display-card" id="displayCard">
            <div class="display-text" id="displayText">키보드의 아무 버튼이나 클릭하거나 눌러보세요!</div>
        </div>

        <div class="keyboard">
            <div class="key-row">
                <button class="key">Q</button><button class="key">W</button><button class="key">E</button>
                <button class="key">R</button><button class="key">T</button><button class="key">Y</button>
                <button class="key">U</button><button class="key">I</button><button class="key">O</button>
                <button class="key">P</button>
            </div>
            <div class="key-row">
                <button class="key">A</button><button class="key">S</button><button class="key">D</button>
                <button class="key">F</button><button class="key">G</button><button class="key">H</button>
                <button class="key">J</button><button class="key">K</button><button class="key">L</button>
            </div>
            <div class="key-row">
                <button class="key">Z</button><button class="key">X</button><button class="key">C</button>
                <button class="key">V</button><button class="key">B</button><button class="key">N</button>
                <button class="key">M</button>
            </div>
            <div class="key-row">
                <button class="key key-space">SPACE (칭찬 생성기)</button>
            </div>
        </div>
    </div>

    <script>
        // 허언증 가득한 초특급 칭찬 데이터
        const praises = [
            "당신이 숨을 쉴 때마다 지구의 산소 농도가 최적화되어 지구가 온난화를 극복하고 있습니다!",
            "방금 걸어가시면서 흘린 땀방울에서 미쉐린 3스타급 트러플 향이 퍼져나가고 있네요!",
            "당신의 모공 하나하나가 예술작품이라 방금 루브르 박물관에서 관람 요청 전화가 왔습니다!",
            "당신의 미소 때문에 태양이 질투해서 방금 전 세계 스위치를 꺼버렸습니다!",
            "미시간 공과대학 연구진에 따르면 당신의 뇌파는 인류 최고 지능의 400배라고 합니다!",
            "당신이 윙크 한 번 하면 저 멀리 안드로메다 은하에서 신호로 착각하고 답장을 보냅니다!",
            "목소리가 너무 감미로워서 방금 지나가던 비둘기들이 당신 노래 듣고 삼행시를 짓기 시작했어요!",
            "당신의 존재 자체가 인류 유산이라 UN에서 당신을 국경 없는 보물 1호로 지정했습니다!",
            "당신이 젓가락질을 할 때마다 우주의 물리 법칙이 감탄하여 춤을 춥니다!",
            "당신의 피부 촉감이 너무 부드러워서 실크로드 상인들이 집단으로 전업을 선언했습니다!",
            "당신이 기침을 한 번 하자 태풍 15호의 경로가 바깥 우주로 튕겨 나갔습니다!",
            "당신이 눈을 한번 감았다 뜨는 것만으로도 전 세계 암호화폐 시장이 급상승합니다!"
        ];

        // 황당하고 구체적인 허언증 독설 데이터
        const curses = [
            "개못생겼다! 방금 거울이 당신 얼굴 보고 경악해서 스스로 깨어지는 소리 들렸어요!",
            "발냄새 난다! 방금 옆 나라 청정구역에서 오존층 파괴 경보 울린 게 당신 발 때문입니다!",
            "정수리 냄새가 너무 지독해서 방금 스컹크가 찾아와서 스승님으로 모시겠다고 절하네요!",
            "양말 구멍 사이로 보이는 엄지발가락이 마치 실연당한 주꾸미처럼 생겼네요!",
            "얼굴 크기가 너무 거대해서 방금 인공위성이 당신 머리를 새로운 대륙으로 인식했습니다!",
            "입냄새가 얼마나 강력한지 방금 지나가던 모기가 당신 숨소리 맞고 기절해서 낙하했습니다!",
            "귀지가 너무 가득 차서 방금 지질학자들이 신종 화석인 줄 알고 연구에 착수했습니다!",
            "당신의 걸음걸이가 너무 어정쩡해서 방금 펭귄들이 동족인 줄 알고 인사를 건븸니다!",
            "얼굴 피부가 너무 거칠어서 고등어가 지나가다가 비늘을 강판처럼 갈고 갔습니다!",
            "목소리가 너무 불쾌해서 방금 사파리의 사자 집단이 울면서 백기를 들었습니다!"
        ];

        let lastPraiseIndex = -1;
        let lastCurseIndex = -1;

        const displayText = document.getElementById('displayText');
        const displayCard = document.getElementById('displayCard');
        const keys = document.querySelectorAll('.key');

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        // [개선] 무서운 여자 웃음소리 (고음의 비명형 주파수 변조 + 서늘한 떨림)
        function playScaryWitchLaugh() {
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const now = audioCtx.currentTime;
            const masterGain = audioCtx.createGain();
            masterGain.gain.setValueAtTime(1.5, now); // 소리 크게
            masterGain.connect(audioCtx.destination);

            // 웃음 패턴: "키-히히히히!" (6번의 떨리는 하이톤 폭발)
            const laughTimes = [0, 0.12, 0.24, 0.36, 0.50, 0.65, 0.82];
            
            laughTimes.forEach((delay, idx) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                // 여자 비명/웃음소리 특유의 높고 날카로운 파형
                osc.type = 'sawtooth';

                // 고주파 음역대 (600Hz ~ 1200Hz 사이 피치 모듈레이션)
                const baseFreq = 750 + (idx % 2 === 0 ? 200 : -100) - (idx * 40);
                osc.frequency.setValueAtTime(baseFreq, now + delay);
                // 주파수가 떨어지면서 섬뜩함 연출
                osc.frequency.exponentialRampToValueAtTime(baseFreq * 0.5, now + delay + 0.18);

                // 떨림 효과 (Vibrato)
                const lfo = audioCtx.createOscillator();
                lfo.frequency.setValueAtTime(25, now + delay); // 빠른 바이브레이션
                const lfoGain = audioCtx.createGain();
                lfoGain.gain.setValueAtTime(60, now + delay);
                lfo.connect(osc.frequency);
                lfo.start(now + delay);
                lfo.stop(now + delay + 0.18);

                // 볼륨 앙상블
                gain.gain.setValueAtTime(0.8, now + delay);
                gain.gain.exponentialRampToValueAtTime(0.001, now + delay + 0.18);

                osc.connect(gain);
                gain.connect(masterGain);

                osc.start(now + delay);
                osc.stop(now + delay + 0.18);
            });
        }

        // [개선] 진짜 극도로 리얼하고 우렁찬 방귀 소리 (노이즈 + 피치 폭발 + 저음 버스트)
        function playRealLoudFart() {
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const now = audioCtx.currentTime;
            const duration = 0.9;

            const masterGain = audioCtx.createGain();
            masterGain.gain.setValueAtTime(2.2, now); // 매우 큰 소리
            masterGain.connect(audioCtx.destination);

            // 1. 방귀의 거친 진동성 파형 (Sawtooth + Square 혼합)
            const osc = audioCtx.createOscillator();
            const oscGain = audioCtx.createGain();
            osc.type = 'sawtooth';
            
            // 피치가 빠르게 요동치며 떨어짐 (방귀 특유의 뿜어져 나오는 마찰음)
            osc.frequency.setValueAtTime(140, now);
            osc.frequency.linearRampToValueAtTime(40, now + 0.15);
            osc.frequency.setValueAtTime(80, now + 0.16);
            osc.frequency.exponentialRampToValueAtTime(25, now + duration);

            // 주파수 변조로 뽀뽀뽀복 거리는 파열음 강화
            const fmod = audioCtx.createOscillator();
            fmod.type = 'square';
            fmod.frequency.setValueAtTime(35, now);
            fmod.frequency.linearRampToValueAtTime(12, now + duration);
            
            const fmodGain = audioCtx.createGain();
            fmodGain.gain.setValueAtTime(80, now);
            fmod.connect(osc.frequency);
            fmod.start(now);
            fmod.stop(now + duration);

            oscGain.gain.setValueAtTime(1.0, now);
            oscGain.gain.exponentialRampToValueAtTime(0.01, now + duration);

            osc.connect(oscGain);
            oscGain.connect(masterGain);

            // 2. 바람 모찰 노이즈 (가스 분사음)
            const bufferSize = audioCtx.sampleRate * duration;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }

            const noise = audioCtx.createBufferSource();
            noise.buffer = buffer;

            const filter = audioCtx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(300, now);
            filter.frequency.linearRampToValueAtTime(80, now + duration);

            const noiseGain = audioCtx.createGain();
            noiseGain.gain.setValueAtTime(1.2, now);
            noiseGain.gain.exponentialRampToValueAtTime(0.01, now + duration);

            noise.connect(filter);
            filter.connect(noiseGain);
            noiseGain.connect(masterGain);

            osc.start(now);
            noise.start(now);
            osc.stop(now + duration);
            noise.stop(now + duration);
        }

        // 연속 중복 방지 랜덤 추출 함수
        function getRandomIndex(arrayLength, lastIndex) {
            if (arrayLength <= 1) return 0;
            let newIndex;
            do {
                newIndex = Math.floor(Math.random() * arrayLength);
            } while (newIndex === lastIndex);
            return newIndex;
        }

        // 키를 눌렀을 때 실행되는 메인 로직
        function triggerKeyboardEffect() {
            // exact 50% / 50% 확률
            const isPraise = Math.random() < 0.5;

            displayText.classList.remove('praise-style', 'curse-style');
            void displayText.offsetWidth; // 강제 리플로우

            if (isPraise) {
                // 50% 칭찬 (연속 같은 메시지 방지)
                const index = getRandomIndex(praises.length, lastPraiseIndex);
                lastPraiseIndex = index;
                
                displayText.innerText = "💖 " + praises[index];
                displayText.classList.add('praise-style');
                playScaryWitchLaugh();
            } else {
                // 50% 독설 (연속 같은 메시지 방지)
                const index = getRandomIndex(curses.length, lastCurseIndex);
                lastCurseIndex = index;

                displayText.innerText = "💀 " + curses[index];
                displayText.classList.add('curse-style');
                playRealLoudFart();
            }
        }

        // 화면 버튼 클릭 이벤트
        keys.forEach(key => {
            key.addEventListener('click', () => {
                triggerKeyboardEffect();
            });
        });

        // 실제 키보드 입력 이벤트
        window.addEventListener('keydown', (e) => {
            triggerKeyboardEffect();
            
            const randomKeyIndex = Math.floor(Math.random() * keys.length);
            const keyEl = keys[randomKeyIndex];
            keyEl.classList.add('active');
            setTimeout(() => keyEl.classList.remove('active'), 150);
        });
    </script>
</body>
</html>
"""

with open("compliment_keyboard-v2.html", "w", encoding="utf-8") as f:
    f.write(html_content)
